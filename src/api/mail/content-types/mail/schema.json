{
  "kind": "collectionType",
  "collectionName": "mails",
  "info": {
    "singularName": "mail",
    "pluralName": "mails",
    "displayName": "Mail"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "subject": {
      "type": "string",
      "required": true
    },
    "receiver": {
      "type": "text",
      "required": true
    },
    "content": {
      "type": "customField",
      "options": {
        "preset": "defaultHtml"
      },
      "customField": "plugin::ckeditor5.CKEditor"
    }
  }
}
