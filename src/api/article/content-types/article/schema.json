{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Article content type for blog posts"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "InFeatured": {
      "default": false,
      "type": "boolean"
    },
    "InSlider": {
      "default": false,
      "type": "boolean"
    },
    "language": {
      "default": "en",
      "enum": [
        "en",
        "bn",
        "both"
      ],
      "required": true,
      "type": "enumeration"
    },
    "likes": {
      "default": 0,
      "type": "integer"
    },
    "slug": {
      "required": true,
      "targetField": "title",
      "type": "uid"
    },
    "storyState": {
      "default": "published",
      "enum": [
        "draft",
        "published",
        "archived",
        "submitted",
        "review"
      ],
      "required": true,
      "type": "enumeration"
    },
    "title": {
      "required": true,
      "type": "string"
    },
    "viewCount": {
      "default": 0,
      "type": "integer"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag"
    },
    "comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::comment.comment",
      "mappedBy": "article"
    },
    "publication_issue": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::publication-issue.publication-issue",
      "inversedBy": "pieces"
    },
    "publication_author_name": {
      "type": "string"
    },
    "DisableComments": {
      "type": "boolean",
      "default": false
    },
    "content": {
      "type": "customField",
      "required": true,
      "options": {
        "preset": "defaultMarkdown"
      },
      "customField": "plugin::ckeditor5.CKEditor"
    },
    "BlogDate": {
      "type": "date"
    },
    "SubmitDate": {
      "type": "date"
    },
    "user_upload_file": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::user-upload.user-upload",
      "mappedBy": "article"
    },
    "bookmarks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::bookmark.bookmark",
      "mappedBy": "article"
    }
  }
}
